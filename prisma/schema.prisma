// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]

  userRole   UserRole @relation(fields: [userRoleId], references: [id])
  userRoleId Int      @default(2)

  employee Employee?

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  admin      Admin?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserRole {
  id Int @id @default(autoincrement())

  name  String @unique
  users User[]

  @@map("user_roles")
}

model EmployeeTask {
  id String @id @default(cuid())

  employeeTaskCategoryId Int
  employeeTaskStatusId   Int

  title        String
  description  String?
  startAt      DateTime
  dueAt        DateTime
  latitude     Float
  longitude    Float
  fileUrls     String[]
  locationName String
  adminId      String
  slug         String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskCategory   EmployeeTaskCategory     @relation(fields: [employeeTaskCategoryId], references: [id])
  employeeTaskAssignment EmployeeTaskAssignment[]
  employeeTaskStatus     EmployeeTaskStatus       @relation(fields: [employeeTaskStatusId], references: [id])
  admin                  Admin                    @relation(fields: [adminId], references: [id])

  @@map("employee_tasks")
}

model EmployeeTaskStatus {
  id Int @id @default(autoincrement())

  name     String @unique
  colorHex String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTask EmployeeTask[]

  @@map("employee_task_statuses")
}

model EmployeeTaskCategory {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTask EmployeeTask[]

  @@map("employee_task_categories")
}

model Employee {
  id String @id @default(cuid())

  userId      String @unique
  phoneNumber String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                     @relation(fields: [userId], references: [id])
  employeeTaskAssignment EmployeeTaskAssignment[]

  @@map("employees")
}

model Admin {
  id String @id @default(cuid())

  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  employeeTasks EmployeeTask[]

  @@map("admins")
}

model EmployeeTaskAssignment {
  id String @id @default(cuid())

  employeeTaskId                 String
  employeeId                     String
  employeeTaskAssignmentStatusId Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTask                 EmployeeTask                 @relation(fields: [employeeTaskId], references: [id])
  employee                     Employee                     @relation(fields: [employeeId], references: [id])
  employeeTaskReports          EmployeeTaskReport[]
  employeeTaskAssignmentStatus EmployeeTaskAssignmentStatus @relation(fields: [employeeTaskAssignmentStatusId], references: [id])

  @@unique([employeeTaskId, employeeId])
  @@map("employee_task_assignments")
}

model EmployeeTaskAssignmentStatus {
  id Int @id @default(autoincrement())

  name     String @unique
  colorHex String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskAssignment EmployeeTaskAssignment[]

  @@map("employee_task_assignment_statuses")
}

model EmployeeTaskReport {
  id Int @id @default(autoincrement())

  employeeTaskAssignmentId   String
  employeeTaskReportStatusId Int

  reportDate DateTime
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskDocuments    EmployeeTaskDocument[]
  employeeTaskReportStatus EmployeeTaskReportStatus @relation(fields: [employeeTaskReportStatusId], references: [id])
  employeeTaskAssignment   EmployeeTaskAssignment   @relation(fields: [employeeTaskAssignmentId], references: [id])

  @@unique([employeeTaskAssignmentId, reportDate])
  @@map("employee_task_reports")
}

model EmployeeTaskReportStatus {
  id Int @id @default(autoincrement())

  name     String
  colorHex String
  icon     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskReports EmployeeTaskReport[]

  @@map("employee_task_report_statuses")
}

model EmployeeTaskDocument {
  id Int @id @default(autoincrement())

  employeeTaskReportId           Int
  employeeTaskDocumentCategoryId Int

  fileUrls String[]
  removedFileUrls String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskReport           EmployeeTaskReport           @relation(fields: [employeeTaskReportId], references: [id])
  employeeTaskDocumentCategory EmployeeTaskDocumentCategory @relation(fields: [employeeTaskDocumentCategoryId], references: [id])

  @@unique([employeeTaskReportId, employeeTaskDocumentCategoryId])
  @@map("employee_task_documents")
}

model EmployeeTaskDocumentCategory {
  id Int @id @default(autoincrement())

  name       String  @unique
  isRequired Boolean @default(true)
  slug       String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeTaskDocument EmployeeTaskDocument[]

  @@map("employee_task_document_categories")
}
